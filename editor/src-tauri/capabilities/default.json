{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Editor permissions. Paths picked in a dialog are added to the fs scope automatically.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-stat",
    "core:window:allow-set-title",
    "core:window:allow-destroy"
  ]
}
